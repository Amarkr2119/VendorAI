APP_MODE=DEMO                  # DEMO | PRODUCTION (policy is applied from Phase 4)
DB_PATH=data/vendorflow.db
UPLOAD_DIR=data/uploads
LOG_LEVEL=INFO
LOG_FILE=logs/vendorflow.log

# ---- LLM (optional: the app works without any LLM) ----
LLM_ENABLED=true
LLM_MODE=always                # always | when_needed (saves free-tier quota: LLM only for scans / incomplete regex reads)
LLM_PRIMARY=gemini             # gemini | groq
LLM_FALLBACK=groq              # groq | gemini | none
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_MIN_INTERVAL_S=4           # client-side spacing between calls to one provider
LLM_QUOTA_COOLDOWN_S=60
GEMINI_API_KEY=
GEMINI_MODEL=                  # choose from: python scripts/check_llm.py --list-models
GROQ_API_KEY=
GROQ_MODEL=

# ---- Documents ----
PDF_BACKEND=auto               # auto | pymupdf | pdfium
OCR_ENGINE=auto                # auto | tesseract | rapidocr | none
OCR_MIN_CONFIDENCE=0.60

# ---- Phase 4: verification and decision policy ----
# APP_MODE=DEMO allows SIMULATED/SANDBOX verification to satisfy mandatory checks (always labelled).
# APP_MODE=PRODUCTION only accepts LIVE verification; anything else keeps the vendor Pending.
VERIFICATION_PROVIDERS=auto    # auto | simulated | none   (auto = LIVE where credentials exist)
VERIFY_TIMEOUT_S=10
VERIFY_MAX_RETRIES=2           # retries after the first attempt (transient errors only)
VERIFY_BACKOFF_S=0.5
SIM_UNKNOWN=accept             # simulated providers, identifier not in fixtures: accept | not_found
COMPANIES_HOUSE_API_KEY=       # free key from developer.company-information.service.gov.uk
COMPANIES_HOUSE_ENV=live       # live | sandbox
HMRC_CLIENT_ID=                # HMRC Developer Hub application (Check a UK VAT number API)
HMRC_CLIENT_SECRET=
HMRC_ENV=sandbox               # sandbox | live
